generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ═══════════════════════════════════════════════════
// CONTENU PRINCIPAL
// ═══════════════════════════════════════════════════

model Manhwa {
  id            String            @id @default(cuid())
  slug          String            @unique

  // Titres
  title_en      String
  title_kr      String?
  title_fr      String?
  title_alt     String[]

  // Contenu
  synopsis_en   String?           @db.Text
  synopsis_fr   String?           @db.Text

  // Médias
  cover_url     String?
  cover_cf_id   String?
  banner_url    String?

  // Metadata
  type          ContentType       @default(MANHWA)
  status        PublicationStatus @default(ONGOING)
  chapter_count Int?
  volume_count  Int?
  release_year  Int?
  end_year      Int?
  origin_country String           @default("KR")
  demographic   String?

  // Contenu & modération
  content_rating    ContentRating  @default(PG13)
  has_nudity        Boolean        @default(false)
  has_gore          Boolean        @default(false)
  has_strong_language Boolean      @default(false)
  cover_is_nsfw     Boolean        @default(false)

  // Stats AniList (JSON: scoreDistribution, statusDistribution, rankings)
  anilist_stats Json?

  // Scores ManhwaVerse (dénormalisés)
  score_avg     Float?
  score_stddev  Float?
  score_positive_rate  Float?       // % votes >= 7/10
  score_count   Int               @default(0)
  review_count  Int               @default(0)
  list_count    Int               @default(0)
  reader_count  Int               @default(0)
  favorite_count Int              @default(0)
  waitlist_count Int              @default(0)

  // Scores externes agrégés
  ext_score_mal           Float?
  ext_score_mal_count     Int?
  ext_score_anilist       Float?
  ext_score_anilist_count Int?
  ext_score_kitsu         Float?
  ext_score_kitsu_count   Int?
  ext_scores_updated_at   DateTime?
  ext_score_composite     Float?

  // Trending
  trending_score Float            @default(0)
  trending_fr    Float            @default(0)
  trending_en    Float            @default(0)

  // Display scores (computed by scoring engine cron + realtime)
  display_score             Float?
  display_score_source      String?   // "AniList" | "ManhwaVerse + AniList" | "ManhwaVerse"
  display_score_phase       String?   // "BOOTSTRAP" | "GROWING" | "MATURE"
  display_score_confidence  Float?    // 0.0 - 1.0
  display_popularity        Int       @default(0)
  display_popularity_source String?

  // Sources externes
  anilist_id    Int?              @unique
  mal_id        Int?              @unique
  mangadex_id   String?           @unique
  kitsu_id      String?           @unique

  // Contrôle
  is_published  Boolean           @default(true)
  is_verified   Boolean           @default(false)
  data_source   String[]
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt
  deleted_at    DateTime?

  // Reaction counters (dénormalisés)
  reaction_heol     Int               @default(0)
  reaction_daebak   Int               @default(0)
  reaction_gamdong  Int               @default(0)
  reaction_kingbat  Int               @default(0)
  reaction_michyeo  Int               @default(0)
  reaction_jukget   Int               @default(0)

  // Relations
  creator_links       ManhwaCreator[]
  genre_links         ManhwaGenre[]
  trope_links         ManhwaTrope[]
  library_entries     UserLibrary[]
  reviews             Review[]
  list_items          ListItem[]
  quotes              Quote[]
  arcs                Arc[]
  releases            Release[]
  read_links          ReadLink[]
  waitlists           Waitlist[]
  similar_to          SimilarManhwa[]          @relation("source")
  similar_from        SimilarManhwa[]          @relation("target")
  relations_as_source ManhwaRelation[]         @relation("rel_source")
  relations_as_target ManhwaRelation[]         @relation("rel_target")
  characters          ManhwaCharacter[]
  score_history       ScoreHistory[]
  external_snapshots  ExternalScoreSnapshot[]
  manhwa_reactions    ManhwaReaction[]
  character_votes     CharacterVote[]
  polls               Poll[]
  article_links       ArticleManhwa[]
  products            ManhwaProduct[]
  publisher_links     ManhwaPublisher[]
  fan_art_posts       FanArtPost[]

  @@index([slug])
  @@index([type, status])
  @@index([score_avg(sort: Desc)])
  @@index([trending_score(sort: Desc)])
  @@index([release_year])
  @@index([display_score(sort: Desc)])
  @@index([display_popularity(sort: Desc)])
}

enum ContentType {
  MANHWA
  MANHUA
}

enum ContentRating {
  G        // Tout public
  PG       // Quelques thèmes matures
  PG13     // Violence, thèmes sombres — défaut
  M        // Mature — ecchi, violence forte
  R18      // Adulte — contenu sexuel non-explicite
  X        // Explicite — fiche uniquement, redirection externe
}

enum ContentFilter {
  SAFE     // défaut — G, PG, PG13
  MATURE   // + M — après confirmation 18+
  ALL      // + R18 — après vérification date de naissance
}

enum PublicationStatus {
  ONGOING
  COMPLETED
  HIATUS
  CANCELLED
  NOT_YET_RELEASED
}

// ── Arcs narratifs
model Arc {
  id            String     @id @default(cuid())
  manhwa_id     String
  manhwa        Manhwa     @relation(fields: [manhwa_id], references: [id])

  name_en       String
  name_fr       String?
  chapter_start Int
  chapter_end   Int?
  position      Int

  score_avg     Float?
  score_count   Int        @default(0)

  arc_scores    ArcScore[]

  created_at    DateTime   @default(now())

  @@index([manhwa_id, position])
}

model ArcScore {
  id         String   @id @default(cuid())
  arc_id     String
  arc        Arc      @relation(fields: [arc_id], references: [id])
  user_id    String
  user       User     @relation(fields: [user_id], references: [id])
  score      Float
  created_at DateTime @default(now())

  @@unique([arc_id, user_id])
}

// ── Liens de lecture légaux
model ReadLink {
  id            String  @id @default(cuid())
  manhwa_id     String
  manhwa        Manhwa  @relation(fields: [manhwa_id], references: [id])
  platform      String
  url           String
  is_free       Boolean @default(false)
  is_official   Boolean @default(true)
  language      String
  is_affiliate  Boolean @default(false)
  affiliate_url String?
}

// ── Titres similaires
model SimilarManhwa {
  id          String   @id @default(cuid())
  source_id   String
  source      Manhwa   @relation("source", fields: [source_id], references: [id])
  target_id   String
  target      Manhwa   @relation("target", fields: [target_id], references: [id])
  similarity  Float
  reasons     String[]
  computed_at DateTime @default(now())

  @@unique([source_id, target_id])
  @@index([source_id, similarity(sort: Desc)])
}

// ── Relations entre manhwas
model ManhwaRelation {
  id            String       @id @default(cuid())
  source_id     String
  source        Manhwa       @relation("rel_source", fields: [source_id], references: [id])
  target_id     String
  target        Manhwa       @relation("rel_target", fields: [target_id], references: [id])
  relation_type RelationType

  @@unique([source_id, target_id, relation_type])
}

enum RelationType {
  ADAPTATION
  SOURCE
  SEQUEL
  PREQUEL
  SIDE_STORY
  ALTERNATIVE
  LIGHT_NOVEL
}

// ── Évolution du score dans le temps
model ScoreHistory {
  id           String   @id @default(cuid())
  manhwa_id    String
  manhwa       Manhwa   @relation(fields: [manhwa_id], references: [id])
  score        Float
  reader_count Int
  recorded_at  DateTime @default(now())

  @@index([manhwa_id, recorded_at])
}

// ── Historique des scores externes
model ExternalScoreSnapshot {
  id          String           @id @default(cuid())
  manhwa_id   String
  manhwa      Manhwa           @relation(fields: [manhwa_id], references: [id])
  platform    ExternalPlatform
  score       Float
  score_raw   Float
  vote_count  Int?
  recorded_at DateTime         @default(now())

  @@unique([manhwa_id, platform, recorded_at])
  @@index([manhwa_id, platform, recorded_at(sort: Desc)])
}

enum ExternalPlatform {
  MAL
  ANILIST
  KITSU
}

// ── Releases
model Release {
  id                 String   @id @default(cuid())
  manhwa_id          String
  manhwa             Manhwa   @relation(fields: [manhwa_id], references: [id])
  chapter            Int
  chapter_title      String?
  platform           String
  url                String?
  released_at        DateTime
  created_at         DateTime @default(now())
  notifications_sent Boolean  @default(false)

  @@unique([manhwa_id, chapter, platform])
  @@index([released_at(sort: Desc)])
}

// ═══════════════════════════════════════════════════
// CRÉATEURS
// ═══════════════════════════════════════════════════

model Creator {
  id             String          @id @default(cuid())
  slug           String          @unique
  name           String
  name_native    String?
  bio_en         String?         @db.Text
  bio_fr         String?         @db.Text
  avatar_url     String?
  nationality    String?
  birth_year     Int?

  avg_score      Float?
  total_readers  Int             @default(0)
  follower_count Int             @default(0)

  anilist_id     Int?

  works          ManhwaCreator[]
  followers      CreatorFollow[]

  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt
}

model ManhwaCreator {
  manhwa_id   String
  manhwa      Manhwa      @relation(fields: [manhwa_id], references: [id])
  creator_id  String
  creator     Creator     @relation(fields: [creator_id], references: [id])
  role        CreatorRole
  role_detail String?

  @@id([manhwa_id, creator_id, role])
}

enum CreatorRole {
  AUTHOR
  ILLUSTRATOR
  BOTH
}

// ── Personnages
model Character {
  id          String            @id @default(cuid())
  slug        String            @unique
  name_en     String
  name_native String?
  name_alt    String[]
  description String?           @db.Text
  age         String?
  gender      String?
  image_url   String?
  anilist_id  Int?              @unique

  manhwa_links ManhwaCharacter[]
  votes        CharacterVote[]

  created_at  DateTime          @default(now())
  updated_at  DateTime          @updatedAt
}

model ManhwaCharacter {
  manhwa_id    String
  manhwa       Manhwa        @relation(fields: [manhwa_id], references: [id])
  character_id String
  character    Character     @relation(fields: [character_id], references: [id])
  role         CharacterRole

  @@id([manhwa_id, character_id])
  @@index([character_id])
}

enum CharacterRole {
  MAIN
  SUPPORTING
  BACKGROUND
}

model CreatorFollow {
  user_id    String
  user       User     @relation(fields: [user_id], references: [id])
  creator_id String
  creator    Creator  @relation(fields: [creator_id], references: [id])
  created_at DateTime @default(now())

  @@id([user_id, creator_id])
}

// ═══════════════════════════════════════════════════
// GENRES & TROPES
// ═══════════════════════════════════════════════════

model Genre {
  id             String        @id @default(cuid())
  slug           String        @unique
  name_en        String
  name_fr        String
  description_en String?       @db.Text
  description_fr String?       @db.Text
  color          String?
  manhwa_count   Int           @default(0)

  manhwa_links   ManhwaGenre[]
}

model ManhwaGenre {
  manhwa_id String
  manhwa    Manhwa @relation(fields: [manhwa_id], references: [id])
  genre_id  String
  genre     Genre  @relation(fields: [genre_id], references: [id])

  @@id([manhwa_id, genre_id])
}

model Trope {
  id             String        @id @default(cuid())
  slug           String        @unique
  name           String
  description_en String?       @db.Text
  description_fr String?       @db.Text
  category       TropeCategory
  manhwa_count   Int           @default(0)

  manhwa_links   ManhwaTrope[]
}

enum TropeCategory {
  PROTAGONIST_TYPE
  NARRATIVE
  SETTING
  THEME
  AMBIANCE
}

model ManhwaTrope {
  manhwa_id   String
  manhwa      Manhwa  @relation(fields: [manhwa_id], references: [id])
  trope_id    String
  trope       Trope   @relation(fields: [trope_id], references: [id])
  upvotes     Int     @default(0)
  downvotes   Int     @default(0)
  added_by    String?
  is_verified Boolean @default(false)

  @@id([manhwa_id, trope_id])
  @@index([manhwa_id, upvotes(sort: Desc)])
}

// ═══════════════════════════════════════════════════
// UTILISATEURS
// ═══════════════════════════════════════════════════

model User {
  id                      String            @id @default(cuid())
  name                    String?
  email                   String?           @unique
  emailVerified           DateTime?
  image                   String?
  username                String?           @unique
  display_name            String?
  avatar_url              String?
  bio                     String?           @db.VarChar(300)
  locale                  String            @default("en")
  content_filter          ContentFilter     @default(SAFE)

  // Paramètres de lecture
  reading_pace            Float?

  // Paramètres notifs
  notif_new_chapter       Boolean           @default(true)
  notif_review_liked      Boolean           @default(true)
  notif_new_follower      Boolean           @default(true)
  notif_weekly_digest     Boolean           @default(true)
  notif_email             Boolean           @default(true)

  // Gamification
  reader_class            String?
  influence_score         Float             @default(0)
  reading_streak          Int               @default(0)
  longest_streak          Int               @default(0)
  last_read_at            DateTime?

  // Stats dénormalisées
  total_chapters_read     Int               @default(0)
  total_manhwas_completed Int               @default(0)

  // Premium
  is_premium              Boolean           @default(false)
  premium_until           DateTime?

  // Artist
  is_artist               Boolean           @default(false)
  artist_bio              String?           @db.Text
  artist_twitter          String?
  artist_instagram        String?
  artist_pixiv            String?
  artist_artstation       String?
  artist_portfolio_url    String?

  // Contrôle
  is_banned               Boolean           @default(false)
  is_seed                 Boolean           @default(false)
  created_at              DateTime          @default(now())
  updated_at              DateTime          @updatedAt

  // Auth.js relations
  accounts                Account[]
  sessions                Session[]

  // Relations
  library                 UserLibrary[]
  reviews                 Review[]
  review_likes            ReviewLike[]
  review_dislikes         ReviewDislike[]
  review_reactions        ReviewReaction[]
  lists                   ManhwaList[]
  list_votes              ListVote[]
  product_wishlists       ProductWishlist[]
  follows                 Follow[]          @relation("follower")
  followers               Follow[]          @relation("following")
  creator_follows         CreatorFollow[]
  quotes                  Quote[]
  quote_votes             QuoteVote[]
  arc_scores              ArcScore[]
  trope_votes             TropeVote[]
  notifications           Notification[]
  activities              Activity[]
  waitlists               Waitlist[]
  reading_rooms           RoomMember[]
  journal_entries         JournalEntry[]
  achievements            UserAchievement[]
  manhwa_reactions        ManhwaReaction[]
  character_votes         CharacterVote[]
  poll_votes              PollVote[]
  reading_challenges      ReadingChallenge[]
  fan_art_posts           FanArtPost[]
  fan_art_likes           FanArtLike[]
  fan_art_comments        FanArtComment[]
}

// ── Auth.js (OAuth accounts, sessions, verification tokens)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Bibliothèque utilisateur
model UserLibrary {
  id            String        @id @default(cuid())
  user_id       String
  user          User          @relation(fields: [user_id], references: [id])
  manhwa_id     String
  manhwa        Manhwa        @relation(fields: [manhwa_id], references: [id])

  status        ReadingStatus
  progress      Int           @default(0)

  score         Float?
  score_private Float?
  is_favorite   Boolean       @default(false)

  started_at    DateTime?
  completed_at  DateTime?

  private_tags  String[]
  notes         String?       @db.Text

  reread_count  Int           @default(0)
  reread_score  Float?

  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt

  @@unique([user_id, manhwa_id])
  @@index([user_id, status])
  @@index([user_id, updated_at(sort: Desc)])
}

enum ReadingStatus {
  READING
  COMPLETED
  ON_HOLD
  DROPPED
  PLAN_TO_READ
  REREADING
}

// ── Journal de lecture (privé)
model JournalEntry {
  id         String   @id @default(cuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id])
  manhwa_id  String
  chapter    Int?
  content    String   @db.Text
  created_at DateTime @default(now())

  @@index([user_id, manhwa_id])
}

// ── Waitlist
model Waitlist {
  user_id     String
  user        User     @relation(fields: [user_id], references: [id])
  manhwa_id   String
  manhwa      Manhwa   @relation(fields: [manhwa_id], references: [id])
  created_at  DateTime @default(now())
  notified_at DateTime?

  @@id([user_id, manhwa_id])
}

// ═══════════════════════════════════════════════════
// REVIEWS & QUOTES
// ═══════════════════════════════════════════════════

model Review {
  id               String     @id @default(cuid())
  user_id          String
  user             User       @relation(fields: [user_id], references: [id])
  manhwa_id        String
  manhwa           Manhwa     @relation(fields: [manhwa_id], references: [id])

  title            String?
  content          String     @db.Text
  score            Float?
  is_micro         Boolean    @default(false)
  has_spoilers     Boolean    @default(false)

  score_story      Float?
  score_art        Float?
  score_characters Float?
  score_world      Float?

  audience_tag     String?

  likes_count      Int        @default(0)
  dislikes_count   Int        @default(0)

  imported_from    String?
  import_url       String?

  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt
  deleted_at       DateTime?

  likes            ReviewLike[]
  dislikes         ReviewDislike[]
  reactions        ReviewReaction[]

  @@index([manhwa_id, likes_count(sort: Desc)])
  @@index([manhwa_id, created_at(sort: Desc)])
  @@index([user_id])
}

model ReviewLike {
  user_id    String
  user       User     @relation(fields: [user_id], references: [id])
  review_id  String
  review     Review   @relation(fields: [review_id], references: [id])
  created_at DateTime @default(now())

  @@id([user_id, review_id])
}

model ReviewDislike {
  user_id    String
  user       User     @relation(fields: [user_id], references: [id])
  review_id  String
  review     Review   @relation(fields: [review_id], references: [id])
  created_at DateTime @default(now())

  @@id([user_id, review_id])
}

model ReviewReaction {
  user_id    String
  user       User           @relation(fields: [user_id], references: [id])
  review_id  String
  review     Review         @relation(fields: [review_id], references: [id])
  reaction   KoreanReaction
  created_at DateTime       @default(now())

  @@id([user_id, review_id, reaction])
}

enum KoreanReaction {
  HEOL      // 헐 — Choqué / Incrédule
  DAEBAK    // 대박 — Incroyable
  GAMDONG   // 감동 — Émouvant
  KINGBAT   // 킹받 — En rage
  MICHYEO   // 미쳤 — Fou/Insensé
  JUKGET    // 죽겠 — Je meurs (overwhelmed)
}

model Quote {
  id         String      @id @default(cuid())
  manhwa_id  String
  manhwa     Manhwa      @relation(fields: [manhwa_id], references: [id])
  user_id    String
  user       User        @relation(fields: [user_id], references: [id])

  content    String      @db.VarChar(500)
  chapter    Int?
  character  String?

  votes      Int         @default(0)

  created_at DateTime    @default(now())
  deleted_at DateTime?

  quote_votes QuoteVote[]

  @@index([manhwa_id, votes(sort: Desc)])
}

model QuoteVote {
  user_id    String
  user       User     @relation(fields: [user_id], references: [id])
  quote_id   String
  quote      Quote    @relation(fields: [quote_id], references: [id])
  value      Int
  created_at DateTime @default(now())

  @@id([user_id, quote_id])
}

model TropeVote {
  user_id    String
  user       User     @relation(fields: [user_id], references: [id])
  manhwa_id  String
  trope_id   String
  value      Int
  created_at DateTime @default(now())

  @@id([user_id, manhwa_id, trope_id])
}

// ═══════════════════════════════════════════════════
// LISTES COMMUNAUTAIRES
// ═══════════════════════════════════════════════════

model ManhwaList {
  id          String     @id @default(cuid())
  slug        String     @unique
  user_id     String
  user        User       @relation(fields: [user_id], references: [id])

  title       String
  description String?    @db.Text
  is_public   Boolean    @default(true)
  is_collab   Boolean    @default(false)

  og_title    String?

  likes_count Int        @default(0)
  item_count  Int        @default(0)

  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt

  items       ListItem[]
  votes       ListVote[]
}

model ListItem {
  id        String     @id @default(cuid())
  list_id   String
  list      ManhwaList @relation(fields: [list_id], references: [id])
  manhwa_id String
  manhwa    Manhwa     @relation(fields: [manhwa_id], references: [id])
  position  Int
  note      String?    @db.VarChar(500)

  added_at  DateTime   @default(now())

  @@unique([list_id, manhwa_id])
  @@index([list_id, position])
}

model ListVote {
  user_id    String
  user       User       @relation(fields: [user_id], references: [id])
  list_id    String
  list       ManhwaList @relation(fields: [list_id], references: [id])
  created_at DateTime   @default(now())

  @@id([user_id, list_id])
}

// ═══════════════════════════════════════════════════
// SOCIAL
// ═══════════════════════════════════════════════════

model Follow {
  follower_id  String
  follower     User     @relation("follower", fields: [follower_id], references: [id])
  following_id String
  following    User     @relation("following", fields: [following_id], references: [id])
  created_at   DateTime @default(now())

  @@id([follower_id, following_id])
  @@index([following_id])
}

model Activity {
  id         String       @id @default(cuid())
  user_id    String
  user       User         @relation(fields: [user_id], references: [id])
  type       ActivityType
  manhwa_id  String?
  metadata   Json?
  created_at DateTime     @default(now())

  @@index([user_id, created_at(sort: Desc)])
  @@index([created_at(sort: Desc)])
}

enum ActivityType {
  ADDED_TO_LIBRARY
  COMPLETED
  RATED
  REVIEWED
  CREATED_LIST
  STARTED_READING
  FAVORITED
}

// ── Reading Rooms
model ReadingRoom {
  id          String        @id @default(cuid())
  slug        String        @unique
  manhwa_id   String
  title       String
  description String?
  is_public   Boolean       @default(true)
  max_members Int           @default(20)

  created_by  String
  created_at  DateTime      @default(now())

  members     RoomMember[]
  messages    RoomMessage[]
}

model RoomMember {
  room_id   String
  room      ReadingRoom @relation(fields: [room_id], references: [id])
  user_id   String
  user      User        @relation(fields: [user_id], references: [id])
  progress  Int         @default(0)
  joined_at DateTime    @default(now())

  @@id([room_id, user_id])
}

model RoomMessage {
  id          String      @id @default(cuid())
  room_id     String
  room        ReadingRoom @relation(fields: [room_id], references: [id])
  user_id     String
  content     String      @db.VarChar(1000)
  chapter_ref Int?
  reaction    String?
  created_at  DateTime    @default(now())

  @@index([room_id, chapter_ref])
}

// ═══════════════════════════════════════════════════
// NOTIFICATIONS
// ═══════════════════════════════════════════════════

model Notification {
  id         String   @id @default(cuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id])
  type       String
  data       Json
  read       Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([user_id, read, created_at(sort: Desc)])
}

// ═══════════════════════════════════════════════════
// GAMIFICATION
// ═══════════════════════════════════════════════════

model Achievement {
  id             String            @id @default(cuid())
  slug           String            @unique
  name_en        String
  name_fr        String
  description_en String
  description_fr String
  icon           String
  category       String

  users          UserAchievement[]
}

model UserAchievement {
  user_id        String
  user           User        @relation(fields: [user_id], references: [id])
  achievement_id String
  achievement    Achievement @relation(fields: [achievement_id], references: [id])
  unlocked_at    DateTime    @default(now())

  @@id([user_id, achievement_id])
}

// ═══════════════════════════════════════════════════
// MODÉRATION
// ═══════════════════════════════════════════════════

model Report {
  id           String    @id @default(cuid())
  reporter_id  String
  content_type String
  content_id   String
  reason       String
  status       String    @default("pending")
  created_at   DateTime  @default(now())
  resolved_at  DateTime?
  resolved_by  String?

  @@index([status, created_at])
  @@index([content_type, content_id])
}

model ModerationLog {
  id          String   @id @default(cuid())
  action      String
  target_id   String
  target_type String
  reason      String
  created_at  DateTime @default(now())
}

// ═══════════════════════════════════════════════════
// AUTOMATISATION & ADMIN
// ═══════════════════════════════════════════════════

model SocialPostQueue {
  id           String    @id @default(cuid())
  platform     String
  content      String    @db.Text
  image_url    String?
  manhwa_id    String?
  scheduled_at DateTime?
  posted_at    DateTime?
  post_url     String?
  status       String    @default("pending")
  error        String?
  created_at   DateTime  @default(now())

  @@index([status, scheduled_at])
}

model SyncLog {
  id            String    @id @default(cuid())
  source        String
  type          String
  items_synced  Int       @default(0)
  items_new     Int       @default(0)
  items_updated Int       @default(0)
  errors        Int       @default(0)
  duration_ms   Int?
  started_at    DateTime  @default(now())
  completed_at  DateTime?
  error_log     String?   @db.Text
}

// ═══════════════════════════════════════════════════
// PRE-LAUNCH FEATURES
// ═══════════════════════════════════════════════════

// ── Réactions coréennes sur les manhwas
model ManhwaReaction {
  user_id    String
  user       User           @relation(fields: [user_id], references: [id])
  manhwa_id  String
  manhwa     Manhwa         @relation(fields: [manhwa_id], references: [id])
  reaction   KoreanReaction
  created_at DateTime       @default(now())

  @@id([user_id, manhwa_id, reaction])
  @@index([manhwa_id])
}

// ── Vote personnage préféré
model CharacterVote {
  id           String    @id @default(cuid())
  user_id      String
  user         User      @relation(fields: [user_id], references: [id])
  manhwa_id    String
  manhwa       Manhwa    @relation(fields: [manhwa_id], references: [id])
  character_id String
  character    Character @relation(fields: [character_id], references: [id])
  created_at   DateTime  @default(now())

  @@unique([user_id, manhwa_id])
  @@index([manhwa_id, character_id])
}

// ── Sondages communautaires
model Poll {
  id          String       @id @default(cuid())
  question_en String
  question_fr String?
  manhwa_id   String?
  manhwa      Manhwa?      @relation(fields: [manhwa_id], references: [id])
  is_active   Boolean      @default(true)
  ends_at     DateTime?
  created_at  DateTime     @default(now())

  options     PollOption[]

  @@index([manhwa_id, is_active])
}

model PollOption {
  id         String     @id @default(cuid())
  poll_id    String
  poll       Poll       @relation(fields: [poll_id], references: [id], onDelete: Cascade)
  label_en   String
  label_fr   String?
  vote_count Int        @default(0)
  position   Int        @default(0)

  votes      PollVote[]
}

model PollVote {
  user_id    String
  user       User       @relation(fields: [user_id], references: [id])
  option_id  String
  option     PollOption @relation(fields: [option_id], references: [id], onDelete: Cascade)
  created_at DateTime   @default(now())

  @@id([user_id, option_id])
}

// ── Blog / Articles
model Article {
  id              String          @id @default(cuid())
  slug            String          @unique
  title_en        String
  title_fr        String?
  content_en      String          @db.Text
  content_fr      String?         @db.Text
  excerpt_en      String?         @db.VarChar(500)
  excerpt_fr      String?         @db.VarChar(500)
  cover_image_url String?
  category        ArticleCategory
  status          ArticleStatus   @default(DRAFT)
  author_name     String
  reading_time    Int?
  view_count      Int             @default(0)
  published_at    DateTime?
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt

  manhwa_links    ArticleManhwa[]

  @@index([status, published_at(sort: Desc)])
  @@index([category, status])
}

model ArticleManhwa {
  article_id String
  article    Article @relation(fields: [article_id], references: [id], onDelete: Cascade)
  manhwa_id  String
  manhwa     Manhwa  @relation(fields: [manhwa_id], references: [id])

  @@id([article_id, manhwa_id])
}

enum ArticleCategory {
  NEWS
  GUIDE
  LIST
  OPINION
  ANALYSIS
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ─── Affiliate Store ───────────────────────────────────────────────────────────

model ManhwaProduct {
  id              String           @id @default(cuid())
  manhwa_id       String
  manhwa          Manhwa           @relation(fields: [manhwa_id], references: [id])

  type            ProductType

  title_en        String
  title_fr        String?

  cover_url       String?
  language        String?          // "fr", "en", "kr", "jp"

  price_amount    Float?
  price_currency  String?
  price_updated_at DateTime?

  asin            String?
  isbn            String?
  ean             String?

  is_featured     Boolean          @default(false)
  position        Int              @default(0)

  links           ProductLink[]
  wishlists       ProductWishlist[]

  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  @@index([manhwa_id, type])
  @@index([type, is_featured])
  @@index([asin])
}

model ProductLink {
  id               String        @id @default(cuid())
  product_id       String
  product          ManhwaProduct @relation(fields: [product_id], references: [id], onDelete: Cascade)

  marketplace_id   String
  url              String

  price_amount     Float?
  price_currency   String?
  price_updated_at DateTime?

  is_available     Boolean       @default(true)

  @@unique([product_id, marketplace_id])
  @@index([marketplace_id])
}

model ProductWishlist {
  user_id    String
  user       User          @relation(fields: [user_id], references: [id])
  product_id String
  product    ManhwaProduct @relation(fields: [product_id], references: [id], onDelete: Cascade)
  created_at DateTime      @default(now())

  @@id([user_id, product_id])
  @@index([user_id, created_at(sort: Desc)])
}

model AffiliateClick {
  id         String   @id @default(cuid())
  user_id    String?
  manhwa_id  String
  product_id String?
  platform   String
  url        String
  created_at DateTime @default(now())

  @@index([manhwa_id, platform])
  @@index([created_at(sort: Desc)])
}

model FanArtPost {
  id            String         @id @default(cuid())
  user_id       String
  manhwa_id     String?
  title         String
  description   String?        @db.Text
  is_nsfw       Boolean        @default(false)
  is_original   Boolean        @default(false)
  credit_name   String?
  credit_url    String?
  tags          String[]
  like_count    Int            @default(0)
  comment_count Int            @default(0)
  view_count    Int            @default(0)
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt

  user     User            @relation(fields: [user_id],    references: [id], onDelete: Cascade)
  manhwa   Manhwa?         @relation(fields: [manhwa_id],  references: [id], onDelete: SetNull)
  images   FanArtImage[]
  comments FanArtComment[]
  likes    FanArtLike[]

  @@index([user_id])
  @@index([manhwa_id])
  @@index([created_at(sort: Desc)])
}

model FanArtImage {
  id         String     @id @default(cuid())
  post_id    String
  image_url  String
  thumb_url  String
  alt_text   String?
  width      Int
  height     Int
  position   Int        @default(0)

  post FanArtPost @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@index([post_id])
}

model FanArtComment {
  id         String          @id @default(cuid())
  post_id    String
  user_id    String
  parent_id  String?
  content    String          @db.Text
  created_at DateTime        @default(now())

  post    FanArtPost    @relation(fields: [post_id],   references: [id], onDelete: Cascade)
  user    User          @relation(fields: [user_id],   references: [id], onDelete: Cascade)
  parent  FanArtComment?  @relation("replies", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies FanArtComment[] @relation("replies")

  @@index([post_id])
}

model FanArtLike {
  user_id    String
  post_id    String
  created_at DateTime @default(now())

  user User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  post FanArtPost @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@id([user_id, post_id])
}

model Publisher {
  id           String            @id @default(cuid())
  slug         String            @unique
  name         String
  name_native  String?
  logo_url     String?
  country      String?
  description  String?           @db.Text
  created_at   DateTime          @default(now())
  updated_at   DateTime          @updatedAt

  manhwa_links ManhwaPublisher[]
}

model ManhwaPublisher {
  manhwa_id    String
  publisher_id String

  manhwa    Manhwa    @relation(fields: [manhwa_id],    references: [id], onDelete: Cascade)
  publisher Publisher @relation(fields: [publisher_id], references: [id], onDelete: Cascade)

  @@id([manhwa_id, publisher_id])
}

model ReadingChallenge {
  id         String   @id @default(cuid())
  user_id    String
  year       Int
  goal       Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, year])
}

enum ProductType {
  PHYSICAL_MANGA
  BOX_SET
  LIGHT_NOVEL
  FIGURINE
  ARTBOOK
  POSTER
  GOODS
}
